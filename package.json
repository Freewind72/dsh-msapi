{
  "name": "dsh-msapi",
  "version": "0.1.9",
  "description": "为 DeepSeek Harness 嵌入 Msapi 音乐播放器：在设置页填好站点地址与接口密钥，播放器就会挂进 DSH 窗口，并由插件控制它的视口范围。",
  "type": "module",
  "main": "./lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "icon.png",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "msapi",
    "music",
    "player",
    "aplayer",
    "embed"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Freewind72/dsh-msapi.git"
  },
  "homepage": "https://github.com/Freewind72/dsh-msapi#readme",
  "bugs": {
    "url": "https://github.com/Freewind72/dsh-msapi/issues"
  },
  "engines": {
    "node": ">=22.12.0",
    "dsh": "^0.2.0-rc.1"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/config.js && node --check lib/msapi.js && node --check lib/player-state.js && node --check lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
